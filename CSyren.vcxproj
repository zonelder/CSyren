    <RootNamespace>CSyren</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <!-- The sandbox has no source/ of its own (the engine's source/ is csyren_host): scan the engine once. -->
    <CSyrenRegistryRoots>$(MSBuildProjectDirectory)\lib;$(MSBuildProjectDirectory)\source</CSyrenRegistryRoots>
    <CSyrenRttiRoots>$(MSBuildProjectDirectory)\lib;$(MSBuildProjectDirectory)\source</CSyrenRttiRoots>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
