<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import after Microsoft.Cpp.targets (see CSyren.project.props).

       A project links the engine as built libraries (Build\<Configuration>\*.lib, listed in
       CSyren.project.props); the engine's projects are not part of the project's solution.
       - A working clone of the engine is built here, before the project, by
         CSyren.libraries.proj (incremental: nothing to do when the libraries are up to date).
       - An installed engine (Build\csyren.installed, written by csyren.py build-engine
         when CSyrenHub installs the engine) is never built by a project: its libraries
         must be there.
       - Inside CSyren.sln (the engine's sandbox) the solution builds the libraries itself. -->
  <PropertyGroup>
    <CSyrenEngineInstalled Condition="Exists('$(CSyrenRoot)Build\csyren.installed')">true</CSyrenEngineInstalled>
    <CSyrenInEngineSolution Condition="'$(SolutionDir)'!='' and '$(SolutionDir)'!='*Undefined*' and '$([MSBuild]::NormalizeDirectory($(SolutionDir)))'=='$([MSBuild]::NormalizeDirectory($(CSyrenRoot)))'">true</CSyrenInEngineSolution>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="$(CSyrenRegistryFile)" />
  </ItemGroup>

  <Target Name="CSyrenBuildEngine" BeforeTargets="PrepareForBuild" DependsOnTargets="CSyrenCheckPackages"
          Condition="'$(CSyrenEngineInstalled)'!='true' and '$(CSyrenInEngineSolution)'!='true'">
    <Message Importance="high" Text="CSyren engine libraries ($(Configuration)): $(CSyrenRoot)" />
    <!-- The engine builds on its own: not in the configuration context of the project's solution. -->
    <MSBuild Projects="$(CSyrenRoot)CSyren.libraries.proj" Targets="Build" BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;BuildingInsideVisualStudio;SolutionDir;SolutionExt;SolutionFileName;SolutionName;SolutionPath" />
  </Target>

  <Target Name="CSyrenCheckEngine" BeforeTargets="PrepareForBuild" Condition="'$(CSyrenEngineInstalled)'=='true'">
    <ItemGroup>
      <_CSyrenMissingLibrary Include="@(CSyrenEngineLibraryFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_CSyrenMissingLibrary)'!=''"
           Text="The installed CSyren engine at $(CSyrenRoot) has no $(Configuration) libraries (missing: @(_CSyrenMissingLibrary->'%(Filename)%(Extension)', ', ')). Build them: py -3 &quot;$(CSyrenRoot)tools\csyren.py&quot; build-engine --config $(Configuration)" />
  </Target>

  <!-- D3D12 redistributables (Microsoft.Direct3D.D3D12 package) next to the executable, as
       dx12_graphic places them next to the engine's own executables. -->
  <Target Name="CSyrenCopyD3D12" AfterTargets="Build" Condition="Exists('$(CSyrenRoot)Build\$(Configuration)\D3D12')">
    <ItemGroup>
      <_CSyrenD3D12File Include="$(CSyrenRoot)Build\$(Configuration)\D3D12\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CSyrenD3D12File)" DestinationFolder="$(OutDir)D3D12" SkipUnchangedFiles="true" />
  </Target>

  <!-- Registry of CS_* markers (tools/csyren_registry.py). The file is rewritten only when
       its content changes, so an unchanged registry does not recompile anything. -->
  <Target Name="CSyrenGenerateRegistry" BeforeTargets="ClCompile;BuildGenerateSources">
    <Exec Command="$(CSyrenPython) &quot;$(CSyrenRoot)tools\csyren_registry.py&quot; --out &quot;$(CSyrenRegistryFile)&quot; --roots &quot;$(CSyrenRegistryRoots)&quot; --include-dirs &quot;$(CSyrenIncludeDirs)&quot; --rtti-roots &quot;$(CSyrenRttiRoots)&quot;"
          CustomErrorRegularExpression="error CSR\d+" />
  </Target>

  <!-- DirectXTex / DirectXTK12 come from the engine's NuGet packages (restored by csyren.py restore). -->
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(CSyrenRoot)packages\directxtex_uwp.2025.7.10.1\build\native\directxtex_uwp.targets" Condition="Exists('$(CSyrenRoot)packages\directxtex_uwp.2025.7.10.1\build\native\directxtex_uwp.targets')" />
    <Import Project="$(CSyrenRoot)packages\directxtk12_uwp.2025.7.10.1\build\native\directxtk12_uwp.targets" Condition="Exists('$(CSyrenRoot)packages\directxtk12_uwp.2025.7.10.1\build\native\directxtk12_uwp.targets')" />
  </ImportGroup>
  <Target Name="CSyrenCheckPackages" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CSyrenRoot)packages\directxtex_uwp.2025.7.10.1\build\native\directxtex_uwp.targets') Or !Exists('$(CSyrenRoot)packages\directxtk12_uwp.2025.7.10.1\build\native\directxtk12_uwp.targets')"
           Text="CSyren NuGet packages are missing in $(CSyrenRoot)packages. Restore them: py -3 &quot;$(CSyrenRoot)tools\csyren.py&quot; restore" />
  </Target>
</Project>
